REGION_CODE="ap-northeast-2"
EKS_CLUSTER_NAME="wsc2026-eks-cluster"

echo "==> 1. Helm 릴리스(Grafana, Prometheus) 삭제"
helm uninstall grafana -n observability 2>/dev/null || true
helm uninstall prometheus -n observability 2>/dev/null || true

echo "==> 2. Fluent Bit K8s 리소스 삭제"
kubectl delete daemonset fluent-bit -n observability 2>/dev/null || true
kubectl delete configmap fluent-bit-config -n observability 2>/dev/null || true

echo "==> 3. StorageClass 삭제"
kubectl delete storageclass wsc2026-sc 2>/dev/null || true

echo "==> 4. EKS Addon (EBS CSI Driver) 삭제"
eksctl delete addon \
  --name aws-ebs-csi-driver \
  --cluster $EKS_CLUSTER_NAME \
  --region $REGION_CODE 2>/dev/null || true

echo "==> 5. IAM Service Accounts (IRSA) 삭제"
# Fluent Bit IRSA 삭제
eksctl delete iamserviceaccount \
  --name fluent-bit-sa \
  --namespace observability \
  --cluster $EKS_CLUSTER_NAME \
  --region $REGION_CODE 2>/dev/null || true

# EBS CSI Controller IRSA 삭제
eksctl delete iamserviceaccount \
  --name ebs-csi-controller-sa \
  --namespace kube-system \
  --cluster $EKS_CLUSTER_NAME \
  --region $REGION_CODE 2>/dev/null || true

echo "==> 모니터링 리소스 정리가 완료되었습니다!"